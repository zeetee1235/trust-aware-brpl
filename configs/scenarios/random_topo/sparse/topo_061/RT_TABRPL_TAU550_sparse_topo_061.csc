<simconf>
  <simulation>
    <title>TA-BRPL RandomTopo TABRPL_TAU550 density=sparse topo=061</title>
    <randomseed>61</randomseed>
    <motedelay_us>1000000</motedelay_us>
    <radiomedium>
      org.contikios.cooja.radiomediums.UDGM
