# Auto detect text files and perform LF normalization
* text=auto

# Exclude only generated/temporary files from language statistics
archive/** linguist-generated
results/** linguist-generated
**/build/** linguist-generated
**/target/** linguist-generated
configs/temp_*.csc linguist-generated

# Mark main project languages explicitly
*.c linguist-language=C linguist-detectable
*.h linguist-language=C linguist-detectable
*.py linguist-language=Python linguist-detectable
*.R linguist-language=R linguist-detectable
*.sh linguist-language=Shell linguist-detectable
*.js linguist-language=JavaScript linguist-detectable
*.rs linguist-language=Rust linguist-detectable

# Source code
*.c text
*.h text
*.py text
*.R text
*.sh text eol=lf
*.js text

# Documentation
*.md text linguist-documentation
*.txt text linguist-documentation
*.pdf binary linguist-documentation
*.svg binary linguist-documentation

# Configuration files
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.conf text

# Nix files
*.nix text linguist-language=Nix linguist-detectable

# Makefiles
Makefile text linguist-language=Makefile linguist-detectable
*.mk text linguist-language=Makefile linguist-detectable

# Scripts should always use LF
*.bash text eol=lf
*.fish text eol=lf
*.zsh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary linguist-documentation
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary

# SVG is text-based
*.svg text linguist-documentation

# Compiled files
*.o binary
*.a binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary

# Data files (exclude from statistics)
*.csv linguist-generated
*.tsv linguist-generated
*.log linguist-generated

# Cooja simulation files
*.csc text linguist-documentation
*.testlog linguist-generated

# Rust specific
*.rs text
Cargo.toml text
Cargo.lock linguist-generated

# Export diff for notebooks
*.ipynb linguist-documentation
