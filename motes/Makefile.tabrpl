# Makefile.tabrpl
# TA-BRPL: Trust-Aware Backpressure RPL
#   - BRPL congestion-aware parent selection
#   - On-node trust model (ta-brpl-trust.c)
#   - Three-component trust: T_fwd, T_ctrl, T_hon

CONTIKI_PROJECT = sender
all: $(CONTIKI_PROJECT)

CONTIKI = ../contiki-ng-brpl
MAKE_ROUTING = MAKE_ROUTING_RPL_CLASSIC

PROJECT_SOURCEFILES += ta-brpl-trust.c

CFLAGS += -DPROJECT_CONF_PATH=\"../project-conf.h\"
CFLAGS += -DBRPL_MODE=1
CFLAGS += -DTABRPL_MODE=1
CFLAGS += -DBRPL_CONF_TRUST_ENABLE=1
CFLAGS += -DCSV_VERBOSE_LOGGING=1
# Escape: require 3 consecutive bad trust windows, 2-min cooldown,
# verified better parent before triggering parent escape
# Trigger window reduced to 60s (default 180s) so escape fires ~590s
# instead of ~780s, giving >300s of effect within 900s simulation
CFLAGS += -DTA_TRUST_ESCAPE_CONSECUTIVE_UPDATES=3
# v13.12 single-policy tuning: longer escape cooldown to reduce repeated
# escape-triggered parent churn bursts.
CFLAGS += -DTA_TRUST_ESCAPE_COOLDOWN_SECONDS=360
CFLAGS += -DTA_TRUST_ESCAPE_REQUIRE_BETTER_PARENT=1
CFLAGS += -DTA_TRUST_ESCAPE_TRIGGER_SECONDS=60
# Allow alternatives up to 300 raw-path units worse than attacker
# (attacker raw≈215, typical alt raw≈448, difference≈233 → 300 gives safe margin)
CFLAGS += -DTA_TRUST_ESCAPE_BETTER_PATH_MARGIN=300
# Conditional eviction: reduced from inert defaults (900s age / 6 updates / 900s cooldown)
# to values achievable within 900s simulation with 350s attack warmup
CFLAGS += -DTA_TRUST_COND_EVICT_MIN_PARENT_AGE_SECONDS=300
CFLAGS += -DTA_TRUST_COND_EVICT_LOW_UPDATES=3
CFLAGS += -DTA_TRUST_COND_EVICT_COOLDOWN_SECONDS=180
# v13.3 stabilization baseline.
CFLAGS += -DTA_TRUST_NN_HOLD_SECONDS=300
# v13.4 stabilization baseline: non-attacker -> non-attacker switch margin.
CFLAGS += -DTA_TRUST_NN_EXTRA_MARGIN=260
# NA re-entry suppression baseline (sweep target: 300/600/900).
CFLAGS += -DTA_TRUST_ATT_REENTRY_HOLD_SECONDS=300
CFLAGS += -DTA_TRUST_ATT_REENTRY_EXTRA_MARGIN=180
# v13.7 gate sensitivity: raise early sinkhole suspicion so attacker
# challenger is blocked in early attack window before capture settles.
CFLAGS += -DTA_ADMISSION_WARN_STREAK=1
CFLAGS += -DTA_ADMISSION_WARN_COUNT=1
LDLIBS += -lm

include $(CONTIKI)/Makefile.include
