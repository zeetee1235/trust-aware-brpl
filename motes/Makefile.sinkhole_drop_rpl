# Sinkhole+Drop attacker for RPL / SMTRUST (MRHOF-based)

CONTIKI_PROJECT = sinkhole_drop_attacker
all: $(CONTIKI_PROJECT)

CONTIKI = ../contiki-ng-brpl
MAKE_ROUTING = MAKE_ROUTING_RPL_CLASSIC
ATTACK_DROP_PCT ?= 50

CFLAGS += -DPROJECT_CONF_PATH=\"../project-conf.h\"
CFLAGS += -DRPL_BASELINE_MODE=1
CFLAGS += -DATTACK_MODE=1
CFLAGS += -DATTACKER_NODE_ID=18
CFLAGS += -DSINKHOLE_RANK_DELTA=1
CFLAGS += -DATTACK_WARMUP_SECONDS=350
CFLAGS += -DSINKHOLE_DIO_PERIOD_SECONDS=15
CFLAGS += -DATTACK_DROP_PCT=$(ATTACK_DROP_PCT)
CFLAGS += -DCSV_VERBOSE_LOGGING=1

include $(CONTIKI)/Makefile.include
