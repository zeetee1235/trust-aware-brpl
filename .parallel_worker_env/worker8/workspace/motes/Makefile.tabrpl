# Makefile.tabrpl
# TA-BRPL: Trust-Aware Backpressure RPL
#   - BRPL congestion-aware parent selection
#   - On-node trust model (ta-brpl-trust.c)
#   - Three-component trust: T_fwd, T_ctrl, T_hon

CONTIKI_PROJECT = sender
all: $(CONTIKI_PROJECT)

CONTIKI = ../contiki-ng-brpl
MAKE_ROUTING = MAKE_ROUTING_RPL_CLASSIC

PROJECT_SOURCEFILES += ta-brpl-trust.c

CFLAGS += -DPROJECT_CONF_PATH=\"../project-conf.h\"
CFLAGS += -DBRPL_MODE=1
CFLAGS += -DTABRPL_MODE=1
CFLAGS += -DBRPL_CONF_TRUST_ENABLE=1
CFLAGS += -DTA_TRUST_TAU_WARN=700
CFLAGS += -DTA_TRUST_TAU_JOIN=450
CFLAGS += -DTA_TRUST_TAU_BLACK=250
CFLAGS += -DTA_TRUST_RESTORE_ON_RELEASE=450
CFLAGS += -DTA_TRUST_LAMBDA_DECREASE=500
CFLAGS += -DTA_TRUST_BLACKLIST_DURATION=120
CFLAGS += -DTA_TRUST_RELEASE_COOLDOWN_SECONDS=120
CFLAGS += -DTA_TRUST_RELEASE_PENALTY_SCALE_START=1600
CFLAGS += -DTA_TRUST_ATTACK_PARENT_PENALTY_SCALE=1700
CFLAGS += -DTA_TRUST_ATTACK_PERSIST_WINDOW_SECONDS=120
CFLAGS += -DTA_TRUST_ATTACK_PERSIST_PENALTY_STEP=250
CFLAGS += -DTA_TRUST_ATTACK_PERSIST_PENALTY_MAX=2600
CFLAGS += -DTA_TRUST_ESCAPE_TRIGGER_SECONDS=180
CFLAGS += -DTA_TRUST_ESCAPE_PENALTY_SCALE=3200
CFLAGS += -DTA_TRUST_ESCAPE_TRUST_THRESHOLD=700
CFLAGS += -DTRUST_MIN=450
CFLAGS += -DBRPL_CONF_TRUST_LAMBDA_PENALTY=450
CFLAGS += -DBRPL_CONF_CURRENT_PARENT_PENALTY_SCALE=700
CFLAGS += -DCSV_VERBOSE_LOGGING=1
LDLIBS += -lm

include $(CONTIKI)/Makefile.include
